# ── Chain ──────────────────────────────────────────────────────────────────────
MONAD_RPC_URL=https://testnet-rpc.monad.xyz
CONTRACT_ADDRESS=0x14b4ee569a9be97e0e0feE136eaffebd36228601

# ── Master account (deployer + resolver + resetter) ────────────────────────────
# Must hold ≥ 5 MON before starting.  Testnet faucet: https://faucet.monad.xyz
PRIVATE_KEY=0x<your-64-char-hex-key>

# ── Relayer (used by the frontend /api/relay endpoint) ─────────────────────────
# Can be the same key as PRIVATE_KEY for single-machine setups.
RELAYER_ADDRESS=0x<relayer-public-address>
RELAYER_PRIVATE_KEY=0x<relayer-private-key>   # server-only — never exposed to browser

# ── Agent wallets (10 required for a full 10-agent swarm) ─────────────────────
# Each needs ≥ 1 MON.  balanceManager.js tops them up automatically.
NUM_AGENTS=10
AGENT_KEY_0=0x...
AGENT_KEY_1=0x...
AGENT_KEY_2=0x...
AGENT_KEY_3=0x...
AGENT_KEY_4=0x...
AGENT_KEY_5=0x...
AGENT_KEY_6=0x...
AGENT_KEY_7=0x...
AGENT_KEY_8=0x...
AGENT_KEY_9=0x...

# ── Frontend env (copy to frontend/.env.local) ─────────────────────────────────
# Also required as Vercel environment variables for production deploys.
NEXT_PUBLIC_CONTRACT_ADDRESS=0x14b4ee569a9be97e0e0feE136eaffebd36228601
NEXT_PUBLIC_RPC_URL=https://testnet-rpc.monad.xyz
# RELAYER_PRIVATE_KEY must also be set in frontend/.env.local (server-side only, never public)
